{
  "entities": {
    "ChildProfile": {
      "title": "ChildProfile",
      "description": "Demographic parent-child profiles mapped inside the radar network",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "parentName": { "type": "string" },
        "childName": { "type": "string" },
        "childAge": { "type": "integer" },
        "childGender": { "type": "string", "enum": ["Boy", "Girl", "Other"] },
        "gradeLevel": { "type": "string" },
        "playStyle": { "type": "string" },
        "bio": { "type": "string" },
        "location": { "type": "object" },
        "locationSharing": { "type": "string", "enum": ["PRECISE", "APPROXIMATE", "HIDDEN"] },
        "profileVisibility": { "type": "string", "enum": ["PRIVATE", "CONNECTIONS", "PUBLIC"] },
        "neighbourhood": { "type": "string" },
        "fuzzedLatitude": { "type": "number" },
        "fuzzedLongitude": { "type": "number" },
        "verificationStatus": { "type": "string", "enum": ["UNVERIFIED", "PENDING", "VERIFIED"] },
        "interests": { "type": "array" },
        "photoUrl": { "type": "string" },
        "parentProfession": { "type": "string" },
        "religion": { "type": "string" },
        "motherTongue": { "type": "string" },
        "languagesKnown": { "type": "array" },
        "aadhaarNumber": { "type": "string" },
        "aadhaarVerified": { "type": "boolean" },
        "attendedEventsCount": { "type": "integer" },
        "checkedInEvents": { "type": "array" },
        "userRole": { "type": "string", "enum": ["Parent", "Daycare Center", "Event Organizer", "Portfolio Professional", "Influencer", "Vendor", "Admin"] },
        "availableDays": { "type": "array" },
        "availableTimes": { "type": "array" }
      },
      "required": ["id", "parentName", "childName"]
    },
    "Playdate": {
      "title": "Playdate",
      "description": "Structured scheduling record between two match guardians",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "hostId": { "type": "string" },
        "guestId": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "location": { "type": "string" },
        "status": { "type": "string", "enum": ["Pending", "Accepted", "Declined", "Completed"] },
        "notes": { "type": "string" },
        "isGroup": { "type": "boolean" }
      },
      "required": ["id", "hostId", "guestId", "date", "status"]
    },
    "Message": {
      "title": "Message",
      "description": "Safe P2P chat messages",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "chatId": { "type": "string" },
        "senderId": { "type": "string" },
        "content": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "chatId", "senderId", "content", "timestamp"]
    },
    "Booking": {
      "title": "Booking",
      "description": "Platform registration or specialist appointment purchase",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "itemId": { "type": "string" },
        "itemTitle": { "type": "string" },
        "type": { "type": "string", "enum": ["EventTicket", "SpecialistAppointment"] },
        "buyerName": { "type": "string" },
        "buyerEmail": { "type": "string" },
        "amountPaid": { "type": "number" },
        "commissionPercentage": { "type": "number" },
        "commissionEarned": { "type": "number" },
        "hostEarned": { "type": "number" },
        "dateStr": { "type": "string" },
        "timeSelected": { "type": "string" },
        "razorpayPaymentId": { "type": "string" },
        "status": { "type": "string", "enum": ["Paid", "Refunded"] }
      },
      "required": ["id", "itemId", "type", "buyerEmail", "amountPaid", "status"]
    },
    "CustomRole": {
      "title": "CustomRole",
      "description": "Custom authorization level configured under the system control panel",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "capabilities": { "type": "array" }
      },
      "required": ["name", "capabilities"]
    },
    "Banner": {
      "title": "Banner",
      "description": "Dynamic promotional advertisements or announcements published by admin users",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "imageUrl": { "type": "string" },
        "linkUrl": { "type": "string" },
        "placement": { "type": "string", "enum": ["home", "app_top", "app_sidebar"] },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "imageUrl", "placement"]
    },
    "PushNotification": {
      "title": "PushNotification",
      "description": "App-wide security and broadcast announcements dispatched by admin operators",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "imageUrl": { "type": "string" },
        "createdAt": { "type": "number" },
        "senderName": { "type": "string" },
        "senderId": { "type": "string" }
      },
      "required": ["id", "title", "body", "createdAt"]
    },
    "FcmDeviceToken": {
      "title": "FcmDeviceToken",
      "description": "Registered FCM token and device notification preferences for parents",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "parentName": { "type": "string" },
        "token": { "type": "string" },
        "platform": { "type": "string", "enum": ["android", "ios", "web"] },
        "preferences": { "type": "object" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "token", "platform"]
    },
    "CustomEventCategory": {
      "title": "CustomEventCategory",
      "description": "Dynamic custom activity or gathering categories managed by administrators",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "value": { "type": "string" }
      },
      "required": ["id", "name", "value"]
    },
    "CustomSpecialistCategory": {
      "title": "CustomSpecialistCategory",
      "description": "Dynamic custom specialist classifications managed by administrators",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "value": { "type": "string" }
      },
      "required": ["id", "name", "value"]
    },
    "CustomProfileField": {
      "title": "CustomProfileField",
      "description": "Dynamic additional metadata fields for matching parents managed by administrators",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fieldName": { "type": "string" },
        "placeholder": { "type": "string" }
      },
      "required": ["id", "fieldName", "placeholder"]
    },
    "SecurityLog": {
      "title": "SecurityLog",
      "description": "Tamper-proof immutable audit events and threat detection logs",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string" },
        "eventType": { "type": "string", "enum": ["UNAUTHORIZED_ACCESS_ATTEMPT", "ADMIN_PANEL_BLOCKED", "RATE_LIMIT_EXCEEDED", "ROLE_ESCALATION_ATTEMPT", "DATA_EXPORT_AUDIT", "LOCKDOWN_TOGGLED", "SECURITY_SCAN"] },
        "severity": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
        "actorUid": { "type": "string" },
        "actorEmail": { "type": "string" },
        "description": { "type": "string" },
        "ipAddress": { "type": "string" },
        "blocked": { "type": "boolean" }
      },
      "required": ["id", "timestamp", "eventType", "severity", "description"]
    },
    "SystemConfig": {
      "title": "SystemConfig",
      "description": "System-wide security lockdown parameters and tab placements",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "emergencyLockdown": { "type": "boolean" },
        "placements": { "type": "object" },
        "updatedAt": { "type": "string" }
      }
    },
    "UserContact": {
      "title": "UserContact",
      "description": "Protected private contact card for family privacy controls",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "parentName": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "email": { "type": "string" },
        "privacyLevel": { "type": "string", "enum": ["hidden", "visible", "connected"] }
      },
      "required": ["userId"]
    },
    "VernuntGroup": {
      "title": "VernuntGroup",
      "description": "Vernunt parent community circles, interest groups, and moms/dads safe spaces",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "coverUrl": { "type": "string" },
        "avatarEmoji": { "type": "string" },
        "privacyTier": { "type": "string", "enum": ["Public", "Private", "Secret"] },
        "genderRestriction": { "type": "string", "enum": ["All Parents", "Female Only", "Male Only"] },
        "creatorId": { "type": "string" },
        "creatorName": { "type": "string" },
        "creatorRole": { "type": "string" },
        "creatorGender": { "type": "string", "enum": ["Mother", "Father", "Other"] },
        "createdAt": { "type": "string" },
        "rules": { "type": "array" },
        "pinnedAnnouncements": { "type": "array" },
        "editors": { "type": "array" },
        "memberIds": { "type": "array" },
        "membersCount": { "type": "integer" },
        "pendingJoinRequests": { "type": "array" },
        "category": { "type": "string" },
        "tags": { "type": "array" },
        "inviteSlug": { "type": "string" }
      },
      "required": ["id", "name", "creatorId"]
    },
    "VernuntGroupMessage": {
      "title": "VernuntGroupMessage",
      "description": "Messages sent inside Vernunt parent community groups",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "groupId": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "senderPhoto": { "type": "string" },
        "senderGender": { "type": "string" },
        "isAnonymous": { "type": "boolean" },
        "content": { "type": "string" },
        "attachments": { "type": "array" },
        "likesCount": { "type": "integer" },
        "likedBy": { "type": "array" },
        "repliesCount": { "type": "integer" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "groupId", "senderId", "content"]
    },
    "UserConsent": {
      "title": "UserConsent",
      "description": "Verifiable record of parental, legal, and privacy policy consent",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "childProfileId": { "type": "string" },
        "consentType": { "type": "string", "enum": ["GUARDIAN_AUTHORITY", "TERMS_OF_SERVICE", "DPDP_PRIVACY", "MARKETING_EMAIL", "COOKIE_ANALYTICS"] },
        "policyVersion": { "type": "string" },
        "timestamp": { "type": "string" },
        "status": { "type": "string", "enum": ["GRANTED", "WITHDRAWN", "REVOKED"] },
        "ipHash": { "type": "string" }
      },
      "required": ["id", "userId", "consentType", "policyVersion", "timestamp", "status"]
    },
    "PrivacyRequest": {
      "title": "PrivacyRequest",
      "description": "Formal user request for data access, export, rectification, or erasure",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "requestType": { "type": "string", "enum": ["DATA_ACCESS", "DATA_DOWNLOAD", "ACCOUNT_DELETION", "CHILD_PROFILE_DELETION", "DATA_CORRECTION", "CONSENT_WITHDRAWAL"] },
        "status": { "type": "string", "enum": ["PENDING", "VERIFYING", "APPROVED", "PROCESSING", "COMPLETED", "REJECTED"] },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" },
        "processedAt": { "type": "string" }
      },
      "required": ["id", "userId", "requestType", "status", "createdAt"]
    },
    "ContentReport": {
      "title": "ContentReport",
      "description": "User safety report regarding inappropriate profile, message, or review",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "reporterId": { "type": "string" },
        "reporterEmail": { "type": "string" },
        "targetType": { "type": "string", "enum": ["profile", "child_profile", "post", "message", "review"] },
        "targetId": { "type": "string" },
        "reason": { "type": "string" },
        "details": { "type": "string" },
        "status": { "type": "string", "enum": ["PENDING", "INVESTIGATING", "WARNED", "ACTION_TAKEN", "DISMISSED"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "reporterId", "targetType", "targetId", "reason", "status", "createdAt"]
    },
    "AssetLicense": {
      "title": "AssetLicense",
      "description": "Audit record for platform fonts, images, icons, and illustrations",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["image", "font", "icon", "illustration"] },
        "source": { "type": "string" },
        "creator": { "type": "string" },
        "license": { "type": "string" },
        "licenseUrl": { "type": "string" },
        "commercialUse": { "type": "boolean" },
        "attributionRequired": { "type": "boolean" },
        "expiry": { "type": "string" },
        "verified": { "type": "boolean" }
      },
      "required": ["id", "name", "type", "license", "commercialUse", "verified"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "ChildProfile",
      "description": "Contains user registration profiles matching their Auth UID"
    },
    "/admins/{adminId}": {
      "schema": "ChildProfile",
      "description": "Strictly restricted database of authorized platform system administrators"
    },
    "/security_logs/{logId}": {
      "schema": "SecurityLog",
      "description": "Immutable tamper-proof platform audit & intrusion logs"
    },
    "/system_config/{configId}": {
      "schema": "SystemConfig",
      "description": "Global security settings, tab configurations, and emergency lockdown states"
    },
    "/subscription_config/{configId}": {
      "schema": "SystemConfig",
      "description": "Master subscription pricing, tiers, and capabilities"
    },
    "/user_contacts/{contactId}": {
      "schema": "UserContact",
      "description": "Private contact directory cards with owner-only access controls"
    },
    "/playdates/{playdateId}": {
      "schema": "Playdate",
      "description": "Stores booked playdate coordination documents"
    },
    "/bookings/{bookingId}": {
      "schema": "Booking",
      "description": "Platform commercial acquisitions logs for events/appointments"
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Subcollection storing real messaging transactions between matched parents"
    },
    "/chat_messages/{messageId}": {
      "schema": "Message",
      "description": "Top-level collection for offline-first local database message synchronization"
    },
    "/custom_roles/{roleId}": {
      "schema": "CustomRole",
      "description": "Secure security access level records created dynamically by supervisors"
    },
    "/banners/{bannerId}": {
      "schema": "Banner",
      "description": "Dynamic promotional advertisements or announcements published by admin users"
    },
    "/push_notifications/{notificationId}": {
      "schema": "PushNotification",
      "description": "App-wide general alerts periodically broadcasted"
    },
    "/custom_event_categories/{id}": {
      "schema": "CustomEventCategory",
      "description": "Stores custom dynamic event types defined by platform supervisors"
    },
    "/custom_specialist_categories/{id}": {
      "schema": "CustomSpecialistCategory",
      "description": "Stores custom professional categories defined by supervisors"
    },
    "/custom_profile_fields/{id}": {
      "schema": "CustomProfileField",
      "description": "Stores custom registration profile fields injected dynamically"
    },
    "/groups/{groupId}": {
      "schema": "VernuntGroup",
      "description": "Stores Vernunt community parent circles and interest groups"
    },
    "/group_messages/{msgId}": {
      "schema": "VernuntGroupMessage",
      "description": "Stores real-time messages within Vernunt parent groups"
    },
    "/user_consents/{id}": {
      "schema": "UserConsent",
      "description": "Stores verifiable parental and user consent records"
    },
    "/privacy_requests/{id}": {
      "schema": "PrivacyRequest",
      "description": "Stores DPDP 2023 data access, download, and deletion requests"
    },
    "/content_reports/{id}": {
      "schema": "ContentReport",
      "description": "Stores user safety reports and moderation queue records"
    },
    "/asset_licenses/{id}": {
      "schema": "AssetLicense",
      "description": "Stores licensing records for platform fonts, images, and visual assets"
    }
  }
}
